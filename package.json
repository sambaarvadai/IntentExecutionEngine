{
  "name": "nl2db-prototype",
  "version": "1.0.0",
  "description": "Minimal natural-language-to-database engine prototype",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "server": "ts-node demo/server.ts",
    "demo": "ts-node demo/live-test.ts",
    "setup-db": "ts-node src/setup-db.ts",
    "init-db": "ts-node src/db/init.ts",
    "migrate-graphs": "ts-node src/db/migrate-graph-tables.ts",
    "migrate-prompt-embedding": "ts-node src/db/migrate-prompt-embedding.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo:api": "ts-node src/demo/runAPI.ts",
    "demo:mock": "ts-node src/demo/runAPI-mock.ts",
    "demo:intent": "ts-node src/demo/intent-demo.ts",
    "demo:debug": "ts-node src/demo/debug-intent-demo.ts"
  },
  "keywords": [
    "nlp",
    "database",
    "prototype"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.81",
    "@anthropic-ai/sdk": "^0.24.3",
    "@chroma-core/default-embed": "^0.1.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "chromadb": "^3.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.7",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
